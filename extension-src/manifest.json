{
  "manifest_version": 3,
  "name": "Next Step",
  "version": "1.4.0",
  "description": "A calm planner that turns assignments into small, doable steps. Opens beside any page.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_title": "Open Next Step", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "side_panel": {"default_path": "panel.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://mycourses.aalto.fi/mod/*"], "js": ["kinds.js", "mycourses.js"], "run_at": "document_idle"}],
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"]
}
